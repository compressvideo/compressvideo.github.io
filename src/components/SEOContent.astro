---
import { type LanguageKey } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: LanguageKey;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="mt-20 sm:mt-28 space-y-24 max-w-5xl mx-auto px-4 sm:px-6">
  <!-- Value Props / Why Us -->
  <div class="space-y-10 text-center">
    <div class="max-w-2xl mx-auto space-y-3">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {t('why.title')}
      </h2>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400">
        {t('why.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
      <!-- Feature 1 -->
      <div class="p-6 rounded-3xl bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 shadow-soft dark:shadow-soft-dark">
        <div class="w-12 h-12 rounded-2xl bg-emerald-100 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
          {t('why.card1.title')}
        </h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          {t('why.card1.desc')}
        </p>
      </div>

      <!-- Feature 2 -->
      <div class="p-6 rounded-3xl bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 shadow-soft dark:shadow-soft-dark">
        <div class="w-12 h-12 rounded-2xl bg-teal-100 dark:bg-teal-950/50 text-teal-600 dark:text-teal-400 flex items-center justify-center mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.29 7 12 12 20.71 7"></polyline>
            <line x1="12" y1="22" x2="12" y2="12"></line>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
          {t('why.card2.title')}
        </h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          {t('why.card2.desc')}
        </p>
      </div>

      <!-- Feature 3 -->
      <div class="p-6 rounded-3xl bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 shadow-soft dark:shadow-soft-dark">
        <div class="w-12 h-12 rounded-2xl bg-amber-100 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
          {t('why.card3.title')}
        </h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          {t('why.card3.desc')}
        </p>
      </div>
    </div>
  </div>

  <!-- Featured Educational Guide Banner -->
  <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-emerald-500/10 via-teal-500/10 to-transparent border border-emerald-500/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div class="space-y-1 max-w-xl">
      <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Featured Technical Guide</span>
      <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
        How to Compress Large Video Files Without Losing Quality
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
        Discover the optimal CRF quality levels, resolution formulas, and device guidelines for Discord, WhatsApp, and email.
      </p>
    </div>
    <a
      href="/how-to-compress-large-video-files/"
      class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs sm:text-sm flex-shrink-0 transition-colors shadow-sm"
    >
      Read Guide →
    </a>
  </div>

  <!-- How It Works Steps -->
  <div class="space-y-10">
    <div class="text-center max-w-xl mx-auto space-y-2">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {t('steps.title')}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="relative flex flex-col items-center text-center p-6 rounded-3xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-700/50">
        <div class="w-10 h-10 rounded-full bg-emerald-600 text-white font-black text-sm flex items-center justify-center mb-4 shadow-md shadow-emerald-600/20">
          1
        </div>
        <h3 class="font-bold text-slate-900 dark:text-white text-base mb-2">
          {t('steps.step1.title')}
        </h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          {t('steps.step1.desc')}
        </p>
      </div>

      <div class="relative flex flex-col items-center text-center p-6 rounded-3xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-700/50">
        <div class="w-10 h-10 rounded-full bg-emerald-600 text-white font-black text-sm flex items-center justify-center mb-4 shadow-md shadow-emerald-600/20">
          2
        </div>
        <h3 class="font-bold text-slate-900 dark:text-white text-base mb-2">
          {t('steps.step2.title')}
        </h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          {t('steps.step2.desc')}
        </p>
      </div>

      <div class="relative flex flex-col items-center text-center p-6 rounded-3xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-700/50">
        <div class="w-10 h-10 rounded-full bg-emerald-600 text-white font-black text-sm flex items-center justify-center mb-4 shadow-md shadow-emerald-600/20">
          3
        </div>
        <h3 class="font-bold text-slate-900 dark:text-white text-base mb-2">
          {t('steps.step3.title')}
        </h3>
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          {t('steps.step3.desc')}
        </p>
      </div>
    </div>
  </div>

  <!-- Frequently Asked Questions Accordion -->
  <div class="space-y-8 max-w-3xl mx-auto">
    <div class="text-center space-y-2">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {t('faq.title')}
      </h2>
    </div>

    <div class="space-y-3">
      <!-- FAQ 1 -->
      <details class="group bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 open:shadow-soft dark:open:shadow-soft-dark transition-all">
        <summary class="flex justify-between items-center font-semibold text-slate-900 dark:text-white cursor-pointer list-none select-none">
          <span class="text-base">{t('faq.q1')}</span>
          <span class="transition group-open:rotate-180 text-emerald-500">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          {t('faq.a1')}
        </p>
      </details>

      <!-- FAQ 2 -->
      <details class="group bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 open:shadow-soft dark:open:shadow-soft-dark transition-all">
        <summary class="flex justify-between items-center font-semibold text-slate-900 dark:text-white cursor-pointer list-none select-none">
          <span class="text-base">{t('faq.q2')}</span>
          <span class="transition group-open:rotate-180 text-emerald-500">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          {t('faq.a2')}
        </p>
      </details>

      <!-- FAQ 3 -->
      <details class="group bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 open:shadow-soft dark:open:shadow-soft-dark transition-all">
        <summary class="flex justify-between items-center font-semibold text-slate-900 dark:text-white cursor-pointer list-none select-none">
          <span class="text-base">{t('faq.q3')}</span>
          <span class="transition group-open:rotate-180 text-emerald-500">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          {t('faq.a3')}
        </p>
      </details>

      <!-- FAQ 4 -->
      <details class="group bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 open:shadow-soft dark:open:shadow-soft-dark transition-all">
        <summary class="flex justify-between items-center font-semibold text-slate-900 dark:text-white cursor-pointer list-none select-none">
          <span class="text-base">{t('faq.q4')}</span>
          <span class="transition group-open:rotate-180 text-emerald-500">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          {t('faq.a4')}
        </p>
      </details>
    </div>
  </div>
</section>
